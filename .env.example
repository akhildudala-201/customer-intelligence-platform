# Example format

# Application
APP_NAME=Customer Intelligence Platform
APP_ENV=development
APP_DEBUG=true

# Server
HOST=127.0.0.1
PORT=8000

# Database
DATABASE_URL=mysql+pymysql://root:your_mysql_password@127.0.0.1:3306/olist
DB_HOST=127.0.0.1
DB_PORT=3306
DB_USER=root
DB_PASSWORD=your_mysql_password
DB_NAME=olist

# Data ingestion
DATASET_DIR=./data

# Model
# The complete ML pipeline writes the calibrated artifact to this path.
MODEL_PATH=outputs/models/lgb_churn_model_calibrated.joblib
MODEL_VERSION=v1

# Logging
LOG_LEVEL=INFO

# CORS
ALLOWED_ORIGINS=http://localhost:3000

# API
API_PREFIX=/api/v1
