#Example format

# Application
APP_NAME=Customer Intelligence Platform
APP_ENV=development
APP_DEBUG=true

# Server
HOST=127.0.0.1
PORT=8000

# Database
DATABASE_URL=sqlite:///./platform.db

# Model
MODEL_PATH=models/churn_model.pkl

# Logging
LOG_LEVEL=INFO

# CORS
ALLOWED_ORIGINS=http://localhost:3000

# API
API_PREFIX=/api/v1