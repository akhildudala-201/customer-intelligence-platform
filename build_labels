"""
CustomerSphere — Feature Engineering Module


HYBRID CUSTOMER CHURN LABELING

Method:
    1. Repeat-purchase behavior
    2. 180-day recency threshold
    3. Censoring for customers whose observation window
       has not yet matured

Label definition:

    0 = RETAINED
        Customer placed a subsequent valid order
        within 180 days of a previous order.

    1 = CHURNED
        Customer did not place a subsequent valid order
        within 180 days AND at least 180 days have
        passed since their last order.

    NaN = CENSORED
        Customer has not repeated yet, but fewer than
        180 days have passed since their last order.

This is a hybrid behavioral + recency-based approach.
"""

import pandas as pd
from sqlalchemy import create_engine, text
from urllib.parse import quote_plus


