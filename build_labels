engine = create_engine(DATABASE_URL)


# ==========================================================
# 2. CHURN CONFIGURATION
# ==========================================================

# Customer must return within this number of days
# to be considered retained.
RETURN_WINDOW_DAYS = 180

# Customer must be inactive for at least this many days
# before being classified as churned.
RECENCY_THRESHOLD_DAYS = 180

# True  = remove censored customers from final output
# False = keep censored customers with label = NaN
EXCLUDE_CENSORED_CUSTOMERS = False


# ==========================================================
# 3. FETCH VALID ORDERS
# ==========================================================

def fetch_valid_orders(reference_date):
    """
    Fetch valid customer orders from MySQL.

    Canceled and unavailable orders are excluded.

    The calculation is performed at customer_unique_id level.
    """

    query = text(
        """
        SELECT
            c.customer_unique_id,
            o.order_id,
            o.order_status,
            o.order_purchase_timestamp
        FROM orders o
        INNER JOIN customers c
            ON o.customer_id = c.customer_id
        WHERE o.order_status NOT IN ('canceled', 'unavailable')
          AND o.order_purchase_timestamp IS NOT NULL
          AND o.order_purchase_timestamp < :reference_date
        """
    )

    with engine.connect() as connection:

        df = pd.read_sql(
            query,
            connection,
            params={
                "reference_date": reference_date
            }
        )

    df["order_purchase_timestamp"] = pd.to_datetime(
        df["order_purchase_timestamp"]
    )

    return df


# ==========================================================
# 4. BUILD HYBRID CHURN LABELS
# ==========================================================

def build_labels():

    print("\nLoading customer order data from MySQL...")

    # ======================================================
    # GET GLOBAL DATASET REFERENCE DATE
    # ======================================================

    with engine.connect() as connection:

        global_max_query = text(
            """
            SELECT MAX(
                GREATEST(
                    COALESCE(
                        order_purchase_timestamp,
                        '1970-01-01'
                    ),
                    COALESCE(
                        order_approved_at,
                        '1970-01-01'
                    ),
                    COALESCE(
                        order_delivered_carrier_date,
                        '1970-01-01'
                    ),
                    COALESCE(
                        order_delivered_customer_date,
                        '1970-01-01'
                    ),
                    COALESCE(
                        order_estimated_delivery_date,
                        '1970-01-01'
                    )
                )
            ) AS max_dataset_date
            FROM orders
            """
        )

        reference_date_raw = connection.execute(
            global_max_query
        ).scalar()

    reference_date = pd.to_datetime(
        reference_date_raw
    )

    print(
        f"Reference date detected: "
        f"{reference_date.date()}"
    )

    # ======================================================
    # LOAD VALID ORDERS
    # ======================================================

    orders = fetch_valid_orders(
        reference_date
    )

    if orders.empty:

        print("\nNo valid orders found.")

        return (
            pd.DataFrame(
                columns=[
                    "customer_unique_id",
                    "first_order_date",
                    "last_order_date",
                    "days_since_last_order",
                    "num_valid_orders",
                    "censored",
                    "label"
                ]
            ),
            reference_date
        )

    # ======================================================
    # SORT ORDERS
    # ======================================================

    orders = orders.sort_values(
        [
            "customer_unique_id",
            "order_purchase_timestamp"
        ]
    )

    # ======================================================
    # CUSTOMER-LEVEL METRICS
    # ======================================================

    grouped = orders.groupby(
        "customer_unique_id"
    )

    result = grouped.agg(
        first_order_date=(
            "order_purchase_timestamp",
            "min"
        ),
        last_order_date=(
            "order_purchase_timestamp",
            "max"
        ),
        num_valid_orders=(
            "order_id",
            "nunique"
        )
    ).reset_index()

    # ======================================================
    # RECENCY
    # ======================================================

    result["days_since_last_order"] = (
        (
            reference_date
            - result["last_order_date"]
        ).dt.total_seconds() / 86400.0
    )

    # ======================================================
    # REPEAT-PURCHASE ANALYSIS
    # ======================================================

    # Find previous order for each customer.

    orders["prev_order_date"] = (
        orders
        .groupby("customer_unique_id")[
            "order_purchase_timestamp"
        ]
        .shift(1)
    )

    # Calculate gap between current and previous order.

    orders["gap_to_prev"] = (
        (
            orders["order_purchase_timestamp"]
            - orders["prev_order_date"]
        ).dt.total_seconds() / 86400.0
    )

    # ======================================================
    # IDENTIFY CUSTOMERS WHO RETURNED WITHIN 180 DAYS
    # ======================================================

    repeat_customers = set(
        orders.loc[
            orders["gap_to_prev"]
            <= RETURN_WINDOW_DAYS,
            "customer_unique_id"
        ]
    )

    result["has_repeat"] = (
        result["customer_unique_id"]
        .isin(repeat_customers)
    )

    # ======================================================
    # HYBRID CENSORING LOGIC
    # ======================================================

    # Censored means:
    #
    # 1. Customer has NOT repeated
    # AND
    # 2. Fewer than 180 days have passed
    #    since their last order.

    result["censored"] = (
        (~result["has_repeat"])
        &
        (
            result["days_since_last_order"]
            < RECENCY_THRESHOLD_DAYS
        )
    )

    # ======================================================
    # HYBRID CHURN LABEL
    # ======================================================

    # Start with unknown labels.

    result["label"] = pd.NA

    # ------------------------------------------------------
    # RETAINED
    # ------------------------------------------------------
    #
    # Customer returned within 180 days.
    #
    # label = 0

    retained_mask = (
        result["has_repeat"]
    )

    result.loc[
        retained_mask,
        "label"
    ] = 0

    # ------------------------------------------------------
    # CHURNED
    # ------------------------------------------------------
    #
    # Customer:
    #
    # - did NOT repeat
    # - AND has been inactive for >= 180 days
    #
    # label = 1

    churned_mask = (
        (~result["has_repeat"])
        &
        (
            result["days_since_last_order"]
            >= RECENCY_THRESHOLD_DAYS
        )
    )

    result.loc[
        churned_mask,
        "label"
    ] = 1

    # ======================================================
    # REMOVE INTERNAL COLUMN
    # ======================================================

    result = result.drop(
        columns=["has_repeat"]
    )

    # ======================================================
    # OPTIONALLY REMOVE CENSORED CUSTOMERS
    # ======================================================

    if EXCLUDE_CENSORED_CUSTOMERS:

        result = result[
            ~result["censored"]
        ].reset_index(drop=True)

    # ======================================================
    # FINAL COLUMN ORDER
    # ======================================================

    result = result[
        [
            "customer_unique_id",
            "first_order_date",
            "last_order_date",
            "days_since_last_order",
            "num_valid_orders",
            "censored",
            "label"
        ]
    ]

    # Convert label to nullable integer.
    # This allows:
    #
    # 0 = retained
    # 1 = churned
    # <NA> = censored

    result["label"] = (
        result["label"]
        .astype("Int64")
    )

    return result, reference_date


# ==========================================================
# 5. SAVE LABELS TO MYSQL
# ==========================================================

def save_labels_to_db(
    df,
    table_name="customer_churn_labels"
):

    print(
        f"\nSaving labels to MySQL table "
        f"`{table_name}`..."
    )

    # MySQL does not use pandas nullable Int64
    # in the same way, so convert missing values to None.

    db_df = df.copy()

    db_df["label"] = (
        db_df["label"]
        .astype(object)
        .where(
            db_df["label"].notna(),
            None
        )
    )

    db_df.to_sql(
        table_name,
        con=engine,
        if_exists="replace",
        index=False,
        chunksize=5000
    )

    print(
        f"Saved -> MySQL table "
        f"`{table_name}` "
        f"({len(db_df):,} rows)"
    )


